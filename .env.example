APP_ENV=local
LOCAL_AUTH_BYPASS=true
HOST=127.0.0.1
PORT=3001
WEB_ORIGIN=http://127.0.0.1:5173
# file is a durable single-process fallback. Use dynamo with Docker Compose.
STORAGE=file
TABLE_NAME=TipRelayLocal
DYNAMODB_ENDPOINT=http://127.0.0.1:8000
AWS_REGION=ap-south-1
SPEECH_LOCAL_URL=http://127.0.0.1:5000
# Production web values are public identifiers. Never put credentials in VITE_*.
VITE_API_URL=http://127.0.0.1:3001
VITE_WS_URL=ws://127.0.0.1:3001
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
VITE_LOCAL_MODE=true
